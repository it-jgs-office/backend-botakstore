APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.botakstore.id
FRONTEND_URL=https://botakstore.id,https://www.botakstore.id
JWT_SECRET=
JWT_TTL=120
JWT_REMEMBER_TTL=43200
JWT_COOKIE=botakstore_session
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=strict
ADMIN_EMAIL=
ADMIN_PASSWORD=
ML_VALIDATION_URL=https://api.isan.eu.org/nickname/ml
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_DEVELOPMENT_KEY=
DIGIFLAZZ_PRODUCTION_KEY=
DIGIFLAZZ_PRODUCTION=true
DIGIFLAZZ_KEY=
DIGIFLAZZ_PRICE_LIST_URL=https://api.digiflazz.com/v1/price-list
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=
PAKASIR_SANDBOX=true
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_REDIRECT_URL=https://botakstore.id/cek-order
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.botakstore.id
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
